# ─────────────────────────────────────────────────────────────
# Postbox — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Neon Postgres (this product's OWN database, separate from any client site)
# https://neon.tech → Project → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Which database that URL points at. REQUIRED locally.
#
# db/guard.ts refuses to connect from a developer machine unless this says
# "development" — because until 23 Aug 2026 there was no dev database and
# .env.local pointed at PRODUCTION, so every dev server and seed script ran
# against a live client’s customer records.
#
# Make a Neon branch (Branches -> New branch, include data), point DATABASE_URL
# at it, and set this. Two minutes, once. See docs/DEV-DATABASE.md.
#
# Not needed on Vercel: VERCEL / VERCEL_ENV are detected there.
DATABASE_ENV=development

# Deliberate, per-command escape hatch for when you really do need production:
#     ALLOW_PRODUCTION_DB=1 npx tsx db/some-script.ts
# Only the literal "1" works. NEVER set it in this file or .env.local — that
# turns a decision into a default and undoes the whole point.
# ALLOW_PRODUCTION_DB=

# Clerk — one workspace login per client
# https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Where Clerk sends users after auth (defaults are fine for App Router)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Resend — sends replies AND parses inbound email
# https://resend.com → API keys
RESEND_API_KEY="re_xxx"
# Shared secret used to verify the inbound webhook (set the same value in Resend)
INBOUND_WEBHOOK_SECRET="choose-a-long-random-string"
# Svix signing secret from the Resend webhook page (preferred webhook auth)
RESEND_WEBHOOK_SIGNING_SECRET="whsec_xxx"
# Address replies/notifications are sent FROM (its domain must be verified in Resend)
EMAIL_FROM_ADDRESS="replies@yourdomain.com"

# Signs the newsletter double opt-in confirmation links (32+ random bytes).
#   openssl rand -hex 32
# REQUIRED for newsletter signups. Without it /api/subscribe/:key refuses every
# submission with a 503 and logs why — it fails closed rather than subscribing
# people without a confirmed click, because a consent record nobody confirmed
# is not evidence of consent, it just looks like it.
# It falls back to INBOUND_WEBHOOK_SECRET so the feature is not dead on arrival,
# but set this: one key per purpose means a leak of either is survivable.
SUBSCRIBE_TOKEN_SECRET=

# Public URL of THIS app (used in the generated install snippet)
NEXT_PUBLIC_APP_URL="https://support.yourapp.com"

# Domain inbound customer email is routed to (per-ticket reply addresses).
# Resend requires the MX on the ROOT domain, so this is usually the apex.
INBOUND_EMAIL_DOMAIN="yourdomain.com"

# "true" enables self-serve sign-up; default is invite-only
OPEN_SIGNUP="false"

# Sentry error monitoring. With no DSN set the SDK is a silent no-op, so the
# app runs fine without these. https://sentry.io → Project → Settings → Client Keys
# The DSN is NOT a secret — it ships inside the browser bundle by design.
NEXT_PUBLIC_SENTRY_DSN="https://xxx@oXXXX.ingest.de.sentry.io/XXXX"
# Optional: server/edge read NEXT_PUBLIC_SENTRY_DSN if this is unset, so setting
# the public one alone is enough. Set this only to point the server at a
# different project than the browser.
# SENTRY_DSN="https://xxx@oXXXX.ingest.de.sentry.io/XXXX"
# Build-time only, and this one IS a secret: uploads source maps so production
# stack traces show real file/line instead of minified soup.
# https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN="sntrys_xxx"

# ── Newsletter sending (Amazon SES, eu-west-1) ─────────────────────────
# The pipeline is complete but INERT until CAMPAIGN_DELIVERY_MODE is set to
# exactly "ses". Anything else — unset, "SES", "true", "1" — uses the
# log-only deliverer, which records what would have been sent and sends
# nothing. Having AWS credentials present is deliberately NOT read as consent.
CAMPAIGN_DELIVERY_MODE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
# Envelope sender for campaigns. MUST be on the marketing subdomain, never
# replies@ — marketing complaints against the primary domain would degrade the
# reputation carrying every tenant's ticket replies.
CAMPAIGN_FROM_ADDRESS=
# SES configuration set, or bounce and complaint events are never emitted.
SES_CONFIGURATION_SET=postbox-newsletters
# REQUIRED for POST /api/webhooks/ses to accept anything at all.
#
# Full ARN of the SNS topic the configuration set publishes Bounce and
# Complaint events to, e.g.
#   arn:aws:sns:eu-west-1:123456789012:postbox-ses-feedback
# The route fails CLOSED: while this is unset it returns 503 to every caller,
# so bounces are never recorded and addresses that hard-bounced keep being
# mailed. A comma-separated list is accepted (staging alongside production).
#
# It is a separate check from the SNS signature, and both are load-bearing.
# A valid signature only proves the message came from Amazon SNS — anybody can
# create their own topic, subscribe this public URL to it, and publish a
# hand-written "bounce" that verifies perfectly. Pinning the ARN is what proves
# it came from OUR topic. Without it this endpoint is a button that permanently
# silences any address in any workspace.
SES_SNS_TOPIC_ARN=
# REQUIRED for the newsletter sweep to run at all.
#
# Shared secret the scheduled sweep presents as `Authorization: Bearer <value>`
# to GET /api/cron/campaigns. The route fails CLOSED: while this is unset it
# returns 503 to every caller, so an unset value is not "cron disabled", it is
# "campaigns never send and nothing obvious says so".
#
# The sweep is driven by .github/workflows/campaign-sweep.yml (GitHub Actions,
# every ~5 minutes), NOT by Vercel Cron — the Hobby plan rejects sub-daily cron
# expressions. So the SAME value must be set in TWO places:
#   1. GitHub → repo Settings → Secrets and variables → Actions → Secrets:
#      new repository secret named CRON_SECRET
#   2. Vercel → Project → Settings → Environment Variables: CRON_SECRET
# The same page needs a repository VARIABLE (not secret) named APP_URL holding
# the deployed origin, e.g. https://postbox.help — that is the host the
# workflow curls.
#
# Any long random string; it must match nothing else. `openssl rand -hex 32`.
CRON_SECRET=

# ── Stripe (billing) ────────────────────────────────────────────────────
#
# ALL OPTIONAL. With STRIPE_SECRET_KEY unset the product runs exactly as it
# does today: Settings -> Billing says payments are not set up, the checkout
# endpoint returns 503, and nothing else changes. That is deliberate — a
# missing billing key must not be able to take the inbox down.
#
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
#
# Signing secret for the webhook endpoint, from
# https://dashboard.stripe.com/webhooks after adding the endpoint
#   POST https://postbox.help/api/webhooks/stripe
# subscribed to: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted
#
# The route FAILS CLOSED without this: every request is refused. That endpoint
# is public and it upgrades accounts, so the signature is the whole of the
# authorisation. Unverified, it is a free-upgrade button for anyone who can
# read the URL.
#
# For local testing: `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
# prints a whsec_... to use here. It is DIFFERENT from the dashboard one.
STRIPE_WEBHOOK_SECRET=
#
# Price ids, one per plan in lib/pricing.ts. Create the products in Stripe as
# recurring monthly prices in GBP matching the published figures (12/29/59).
#
# Env vars rather than hardcoded ids because test mode and live mode have
# entirely different ids — hardcoding either guarantees one of the two
# environments charges nothing or charges the wrong amount. An unrecognised
# price arriving on a webhook does NOT grant a plan; it is logged loudly and
# the entitlement is left alone.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=
