# ─────────────────────────────────────────────────────────────
# Postbox — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Neon Postgres (this product's OWN database, separate from any client site)
# https://neon.tech → Project → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Clerk — one workspace login per client
# https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Where Clerk sends users after auth (defaults are fine for App Router)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Resend — sends replies AND parses inbound email
# https://resend.com → API keys
RESEND_API_KEY="re_xxx"
# Shared secret used to verify the inbound webhook (set the same value in Resend)
INBOUND_WEBHOOK_SECRET="choose-a-long-random-string"
# Svix signing secret from the Resend webhook page (preferred webhook auth)
RESEND_WEBHOOK_SIGNING_SECRET="whsec_xxx"
# Address replies/notifications are sent FROM (its domain must be verified in Resend)
EMAIL_FROM_ADDRESS="replies@yourdomain.com"

# Public URL of THIS app (used in the generated install snippet)
NEXT_PUBLIC_APP_URL="https://support.yourapp.com"

# Domain inbound customer email is routed to (per-ticket reply addresses).
# Resend requires the MX on the ROOT domain, so this is usually the apex.
INBOUND_EMAIL_DOMAIN="yourdomain.com"

# "true" enables self-serve sign-up; default is invite-only
OPEN_SIGNUP="false"

# Sentry error monitoring. With no DSN set the SDK is a silent no-op, so the
# app runs fine without these. https://sentry.io → Project → Settings → Client Keys
# The DSN is NOT a secret — it ships inside the browser bundle by design.
NEXT_PUBLIC_SENTRY_DSN="https://xxx@oXXXX.ingest.de.sentry.io/XXXX"
# Optional: server/edge read NEXT_PUBLIC_SENTRY_DSN if this is unset, so setting
# the public one alone is enough. Set this only to point the server at a
# different project than the browser.
# SENTRY_DSN="https://xxx@oXXXX.ingest.de.sentry.io/XXXX"
# Build-time only, and this one IS a secret: uploads source maps so production
# stack traces show real file/line instead of minified soup.
# https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN="sntrys_xxx"

# ── Newsletter sending (Amazon SES, eu-west-1) ─────────────────────────
# The pipeline is complete but INERT until CAMPAIGN_DELIVERY_MODE is set to
# exactly "ses". Anything else — unset, "SES", "true", "1" — uses the
# log-only deliverer, which records what would have been sent and sends
# nothing. Having AWS credentials present is deliberately NOT read as consent.
CAMPAIGN_DELIVERY_MODE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
# Envelope sender for campaigns. MUST be on the marketing subdomain, never
# replies@ — marketing complaints against the primary domain would degrade the
# reputation carrying every tenant's ticket replies.
CAMPAIGN_FROM_ADDRESS=
# SES configuration set, or bounce and complaint events are never emitted.
SES_CONFIGURATION_SET=postbox-newsletters
# Shared secret Vercel Cron presents. The sweep refuses everyone when unset.
CRON_SECRET=
