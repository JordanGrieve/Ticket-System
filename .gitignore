# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# agent skills (reproducible from skills-lock.json via `npx skills add`)
/.agents/
/.claude/skills/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scratch reproductions and throwaway worktrees
.tmp-*/

# Throwaway output of scripts/pill-harness.mjs. The impersonation pill only
# renders while an operator is inside a client workspace, so it cannot be seen
# in the preview browser; the harness paints it from the real stylesheet. The
# script is worth keeping, the generated page is not.
public/_pill.html
public/_harness.html
